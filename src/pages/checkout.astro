---
// @ts-nocheck
import Navbar from '../components/Navbar.astro';
let cart = [];
let rawCartData = '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const cartData = formData.get('cart_data');

    if (typeof cartData === 'string') {
        rawCartData = cartData;

        try {
            const parsedCart = JSON.parse(cartData);
            if (Array.isArray(parsedCart)) {
                cart = parsedCart;
            } else {
                errorMessage = 'Data pesanan tidak valid.';
            }
        } catch (error) {
            errorMessage = 'Data pesanan tidak dapat diproses.';
            console.error(error);
        }
    } else {
        errorMessage = 'Data pesanan tidak ditemukan.';
    }
}

const subtotal = cart.reduce(
    (total, item) => total + Number(item.price || 0) * Number(item.qty || 0),
    0,
);
const total = subtotal;
const totalQuantity = cart.reduce(
    (quantity, item) => quantity + Number(item.qty || 0),
    0,
);
const formatRupiah = (value) =>
    new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        minimumFractionDigits: 0,
    }).format(value);
---

<!doctype html>
<html lang='id'>
    <head>
        <meta charset='UTF-8' />
        <meta
            name='viewport'
            content='width=device-width, initial-scale=1.0'
        />
        <title>Checkout - Dapur Ina Aina</title>
        <link
            href='/css/bootstrap.min.css'
            rel='stylesheet'
        />
        <link
            rel='stylesheet'
            href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css'
        />
        <style>
            body {
                background: #f8f9fa;
            }
            .checkout-header {
                background: #dc3545;
            }
            .checkout-card {
                border: 0;
                border-radius: 15px;
            }
            .item-row:last-child {
                border-bottom: 0 !important;
            }
        </style>
    </head>
    <body>
        <Navbar
            variant='checkout'
            backMethod='POST'
            cartData={rawCartData}
        />

        <main class='container py-4 pb-5'>
            <div class='mb-4'>
                <h1 class='h3 fw-bold mb-1'>Checkout Pesanan</h1>
                <p class='text-muted mb-0'>
                    Periksa kembali pesanan Anda sebelum melanjutkan pembayaran.
                </p>
            </div>

            {
                errorMessage && (
                    <div
                        class='alert alert-danger'
                        role='alert'
                    >
                        {errorMessage}
                    </div>
                )
            }

            {
                cart.length > 0 ? (
                    <form
                        action='/pembayaran'
                        method='POST'
                    >
                        <input
                            type='hidden'
                            name='cart_data'
                            value={rawCartData}
                        />

                        <div class='row g-4'>
                            <div class='col-lg-7'>
                                <section class='card checkout-card shadow-sm'>
                                    <div class='card-body p-4'>
                                        <h2 class='h5 fw-bold mb-4'>
                                            <i class='bi bi-basket me-2 text-danger' />
                                            Detail Pesanan
                                        </h2>
                                        {cart.map((item) => (
                                            <div class='item-row d-flex justify-content-between align-items-center border-bottom py-3'>
                                                <div>
                                                    <h3 class='h6 fw-bold mb-1'>
                                                        {item.name}
                                                    </h3>
                                                    <span class='text-muted small'>
                                                        {formatRupiah(
                                                            item.price,
                                                        )}{' '}
                                                        x {item.qty}
                                                    </span>
                                                </div>
                                                <strong class='text-danger'>
                                                    {formatRupiah(
                                                        Number(item.price) *
                                                            Number(item.qty),
                                                    )}
                                                </strong>
                                            </div>
                                        ))}
                                    </div>
                                </section>

                                <section class='card checkout-card shadow-sm mt-4'>
                                    <div class='card-body p-4'>
                                        <h2 class='h5 fw-bold mb-4'>
                                            <i class='bi bi-person-vcard me-2 text-danger' />
                                            Informasi Pemesan
                                        </h2>
                                        <div class='mb-3'>
                                            <label
                                                for='customerName'
                                                class='form-label'
                                            >
                                                Nama Pemesan
                                            </label>
                                            <input
                                                id='customerName'
                                                name='nama_pemesan'
                                                type='text'
                                                class='form-control'
                                                placeholder='Masukkan nama Anda'
                                                required
                                            />
                                        </div>
                                        <div>
                                            <label
                                                for='tableNumber'
                                                class='form-label'
                                            >
                                                Nomor Meja
                                            </label>
                                            <input
                                                id='tableNumber'
                                                name='nomor_meja'
                                                type='number'
                                                class='form-control'
                                                placeholder='Contoh: 12'
                                                min='1'
                                                required
                                            />
                                        </div>
                                        <div class='mt-4'>
                                            <label
                                                for='paymentMethod'
                                                class='form-label'
                                            >
                                                Metode Pembayaran
                                            </label>
                                            <select
                                                id='paymentMethod'
                                                name='metode_pembayaran'
                                                class='form-select'
                                                required
                                            >
                                                <option
                                                    value=''
                                                    selected
                                                    disabled
                                                >
                                                    Pilih metode pembayaran
                                                </option>
                                                <option value='Tunai'>
                                                    Tunai (Kasir)
                                                </option>
                                                <option value='Non Tunai'>
                                                    Non Tunai
                                                    (QRIS/Debit/Kredit)
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <div class='col-lg-5'>
                                <section class='card checkout-card shadow-sm'>
                                    <div class='card-body p-4'>
                                        <h2 class='h5 fw-bold mb-4'>
                                            Ringkasan Pembayaran
                                        </h2>
                                        <div class='d-flex justify-content-between mb-2'>
                                            <span class='text-muted'>
                                                Total item
                                            </span>
                                            <span>{totalQuantity}</span>
                                        </div>
                                        <div class='d-flex justify-content-between mb-2'>
                                            <span class='text-muted'>
                                                Subtotal
                                            </span>
                                            <span>
                                                {formatRupiah(subtotal)}
                                            </span>
                                        </div>
                                        <hr />
                                        <div class='d-flex justify-content-between align-items-center mb-4'>
                                            <strong class='fs-5'>
                                                Total Bayar
                                            </strong>
                                            <strong class='fs-5 text-danger'>
                                                {formatRupiah(total)}
                                            </strong>
                                        </div>
                                        <button
                                            type='submit'
                                            class='btn btn-danger w-100 fw-bold py-2 rounded-pill'
                                        >
                                            Lanjut Pembayaran{' '}
                                            <i class='bi bi-arrow-right ms-1' />
                                        </button>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </form>
                ) : (
                    <section class='card checkout-card shadow-sm text-center'>
                        <div class='card-body p-5'>
                            <i
                                class='bi bi-basket text-muted'
                                style='font-size: 4rem;'
                            />
                            <h2 class='h5 fw-bold mt-3'>
                                Pesanan masih kosong
                            </h2>
                            <p class='text-muted'>
                                Silakan pilih menu terlebih dahulu.
                            </p>
                            <a
                                href='/'
                                class='btn btn-danger rounded-pill px-4'
                            >
                                Kembali ke Menu
                            </a>
                        </div>
                    </section>
                )
            }
        </main>
    </body>
</html>
