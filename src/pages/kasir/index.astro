// @ts-nocheck
const BACKEND_URL = import.meta.env.BACKEND_URL || 'http://localhost:3000';
const jwtToken = Astro.cookies.get('token')?.value;
const kasir = {
    id: Astro.cookies.get('idKasir')?.value,
    nama: Astro.cookies.get('namaKasir')?.value,
};
let orders = [];
let apiError = '';
let paymentError = '';
let printData = null;

if (!jwtToken) {
    return Astro.redirect('/kasir/login');
}

try {
    const response = await fetch(`${BACKEND_URL}/api/kasir/antrean`, {
        headers: { Authorization: `Bearer ${jwtToken}` },
    });
    const result = await response.json();

    if (!response.ok || result.status !== 'sukses') {
        apiError = result.message || 'Antrean pembayaran tidak dapat dimuat.';
    } else if (Array.isArray(result.data)) {
        orders = result.data.map((order) => ({
            ...order,
            nama_pelanggan: order.nama || order.nama_pelanggan || '-',
            items: Array.isArray(order.items) ? order.items : [],
        }));
    }
} catch (error) {
    apiError = 'Backend antrean kasir tidak dapat dihubungi.';
    console.error(error);
}

if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const idPesanan = formData.get('idPesanan');
    const kembalian = formData.get('kembalian');

    if (typeof idPesanan === 'string' && typeof kembalian === 'string') {
        const paymentPostData = {
            id_pesanan: Number(idPesanan),
            kembalian: Number(kembalian),
        };
        const selectedOrder = orders.find(
            (order) => order.id_pesanan === paymentPostData.id_pesanan,
        );

        try {
            const response = await fetch(
                `${BACKEND_URL}/api/kasir/proses-bayar`,
                {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        Authorization: `Bearer ${jwtToken}`,
                    },
                    body: JSON.stringify(paymentPostData),
                },
            );
            const result = await response.json();

            if (!response.ok || result.status !== 'sukses') {
                paymentError =
                    result.message || 'Pembayaran tunai gagal diproses.';
            } else {
                const paymentData = result.data || {};
                let receiptData = paymentData;

                try {
                    const receiptResponse = await fetch(
                        `${BACKEND_URL}/api/pesanan/${encodeURIComponent(
                            paymentPostData.id_pesanan,
                        )}/struk`,
                    );
                    const receiptResult = await receiptResponse.json();

                    if (
                        receiptResponse.ok &&
                        receiptResult.status === 'success' &&
                        receiptResult.data
                    ) {
                        receiptData = receiptResult.data;
                    }
                } catch (error) {
                    console.error(
                        'Data detail struk tidak dapat dimuat:',
                        error,
                    );
                }

                const receiptItems = Array.isArray(receiptData.items)
                    ? receiptData.items
                    : Array.isArray(paymentData.items)
                      ? paymentData.items
                      : Array.isArray(selectedOrder?.items)
                        ? selectedOrder.items
                        : [];

                printData = {
                    ...(selectedOrder || {}),
                    ...paymentData,
                    ...receiptData,
                    items: receiptItems,
                    id_pesanan:
                        receiptData.id_pesanan ||
                        paymentData.id_pesanan ||
                        paymentPostData.id_pesanan,
                    kembalian: paymentPostData.kembalian,
                };
                orders = orders.filter(
                    (order) => order.id_pesanan !== paymentPostData.id_pesanan,
                );
            }
        } catch (error) {
            paymentError = 'Backend pembayaran kasir tidak dapat dihubungi.';
            console.error(error);
        }
    } else {
        paymentError = 'Data pembayaran tidak lengkap.';
    }
}
