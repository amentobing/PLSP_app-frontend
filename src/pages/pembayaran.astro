---
// @ts-nocheck
import Navbar from '../components/Navbar.astro';
const BACKEND_URL = import.meta.env.BACKEND_URL;
const SECRET_CLIENT_KEY_MIDTRANS = import.meta.env.SECRET_CLIENT_MIDTRANS;
const ORDER_API_PATH = '/api/checkout';
let cart = [];
let customerName = '';
let tableNumber = '';
let paymentMethod = '';
let orderResponse = null;
let errorMessage = '';

if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const cartData = formData.get('cart_data');
    const submittedName = formData.get('nama_pemesan');
    const submittedTable = formData.get('nomor_meja');
    const submittedPaymentMethod = formData.get('metode_pembayaran');

    customerName = typeof submittedName === 'string' ? submittedName : '';
    tableNumber = typeof submittedTable === 'string' ? submittedTable : '';
    paymentMethod =
        typeof submittedPaymentMethod === 'string'
            ? submittedPaymentMethod
            : '';

    if (typeof cartData !== 'string') {
        errorMessage = 'Data pesanan tidak ditemukan.';
    } else {
        try {
            const parsedCart = JSON.parse(cartData);
            if (!Array.isArray(parsedCart) || parsedCart.length === 0) {
                errorMessage = 'Data pesanan kosong atau tidak valid.';
            } else {
                cart = parsedCart;
            }
        } catch (error) {
            errorMessage = 'Data pesanan tidak dapat diproses.';
            console.error(error);
        }
    }

    if (!errorMessage && !paymentMethod) {
        errorMessage = 'Metode pembayaran belum dipilih.';
    }

    if (!errorMessage) {
        const totalTagihan = cart.reduce(
            (total, item) =>
                total + Number(item.price || 0) * Number(item.qty || 0),
            0,
        );

        try {
            const response = await fetch(`${BACKEND_URL}${ORDER_API_PATH}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    nama_pemesan: customerName,
                    nomor_meja: tableNumber,
                    metode_pembayaran: paymentMethod,
                    total_tagihan: totalTagihan,
                    cart_data: JSON.stringify(cart),
                }),
            });
            const result = await response.json();

            if (!response.ok || result.status !== 'success') {
                errorMessage = result.message || 'Pesanan gagal dibuat.';
            } else {
                orderResponse = result;
            }
        } catch (error) {
            errorMessage = 'Backend pesanan tidak dapat dihubungi.';
            console.error(error);
        }
    }
} else {
    errorMessage = 'Halaman pembayaran harus dibuka melalui checkout.';
}

const totalQuantity = cart.reduce(
    (total, item) => total + Number(item.qty || 0),
    0,
);
const subtotal = cart.reduce(
    (total, item) => total + Number(item.price || 0) * Number(item.qty || 0),
    0,
);
const formatRupiah = (value) =>
    new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        minimumFractionDigits: 0,
    }).format(value);

const paymentData = orderResponse?.data;
---

<!doctype html>
<html lang='id'>
    <head>
        <meta charset='UTF-8' />
        <meta
            name='viewport'
            content='width=device-width, initial-scale=1.0'
        />
        <title>Status Pembayaran - Dapur Ina Aina</title>
        <link
            href='/css/bootstrap.min.css'
            rel='stylesheet'
        />
        <link
            rel='stylesheet'
            href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css'
        />
        <script
            src='https://app.sandbox.midtrans.com/snap/snap.js'
            data-client-key={SECRET_CLIENT_KEY_MIDTRANS}
        ></script>
        <style>
            body {
                background: #f8f9fa;
            }
            .payment-header {
                background: #dc3545;
            }
            .payment-card {
                border: 0;
                border-radius: 15px;
            }
            .gateway-frame {
                width: 100%;
                min-height: 620px;
                border: 0;
                border-radius: 10px;
            }
        </style>
    </head>
    <body>
        <Navbar
            variant='payment'
            title='Pembayaran'
        />

        <main class='container py-4 pb-5'>
            {
                errorMessage ? (
                    <section class='card payment-card shadow-sm'>
                        <div class='card-body text-center p-5'>
                            <i
                                class='bi bi-x-circle text-danger'
                                style='font-size: 4rem;'
                            />
                            <h1 class='h4 fw-bold mt-3'>
                                Pesanan Belum Berhasil Diproses
                            </h1>
                            <p class='text-muted'>{errorMessage}</p>
                            <a
                                href='/'
                                class='btn btn-danger rounded-pill px-4'
                            >
                                Kembali ke Menu
                            </a>
                        </div>
                    </section>
                ) : orderResponse && paymentData ? (
                    <>
                        <section class='card payment-card shadow-sm mb-4'>
                            <div class='card-body text-center p-4'>
                                <i
                                    class='bi bi-check-circle-fill text-success'
                                    style='font-size: 3.5rem;'
                                />
                                <h1 class='h4 fw-bold mt-3'>
                                    {orderResponse.message}
                                </h1>
                                <p class='text-muted mb-0'>
                                    Nomor pesanan:{' '}
                                    <strong>#{paymentData.id_pesanan}</strong>
                                </p>
                            </div>
                        </section>

                        <div class='row g-4'>
                            <div class='col-lg-7'>
                                {paymentData.metode === 'Non Tunai' ? (
                                    <section class='card payment-card shadow-sm'>
                                        <div class='card-body p-3 p-md-4'>
                                            <h2 class='h5 fw-bold mb-3'>
                                                <i class='bi bi-credit-card me-2 text-danger' />
                                                Pembayaran Digital
                                            </h2>
                                            <div
                                                id='snap-container'
                                                style={{
                                                    width: '100%',
                                                    minHeight: '600px',
                                                }}
                                            />
                                        </div>
                                    </section>
                                ) : (
                                    <section class='card payment-card shadow-sm'>
                                        <div class='card-body text-center p-5'>
                                            <i
                                                class='bi bi-cash-coin text-success'
                                                style='font-size: 4rem;'
                                            />
                                            <h2 class='h4 fw-bold mt-3'>
                                                Bayar di Kasir
                                            </h2>
                                            <p class='text-muted mb-0'>
                                                Jangan Tutup Halaman Ini.
                                                Silakan menuju kasir dan
                                                tunjukkan nomor pesanan Anda
                                                untuk menyelesaikan pembayaran.
                                            </p>
                                        </div>
                                    </section>
                                )}
                            </div>

                            <div class='col-lg-5'>
                                <section class='card payment-card shadow-sm'>
                                    <div class='card-body p-4'>
                                        <h2 class='h5 fw-bold mb-4'>
                                            Ringkasan Pesanan
                                        </h2>
                                        <div class='d-flex justify-content-between mb-2'>
                                            <>
                                                <span class='text-muted'>
                                                    Nama
                                                </span>
                                                <span>{customerName}</span>
                                            </>
                                        </div>
                                        <div class='d-flex justify-content-between mb-2'>
                                            <>
                                                <span class='text-muted'>
                                                    Nomor meja
                                                </span>
                                                <span>{tableNumber}</span>
                                            </>
                                        </div>
                                        <div class='d-flex justify-content-between mb-2'>
                                            <>
                                                <span class='text-muted'>
                                                    Total item
                                                </span>
                                                <span>{totalQuantity}</span>
                                            </>
                                        </div>
                                        <div class='d-flex justify-content-between mb-3'>
                                            <>
                                                <span class='text-muted'>
                                                    Metode
                                                </span>
                                                <span>
                                                    {paymentData.metode}
                                                </span>
                                            </>
                                        </div>
                                        <hr />
                                        <div class='d-flex justify-content-between'>
                                            <>
                                                <strong>Total Tagihan</strong>
                                                <strong class='text-danger'>
                                                    {formatRupiah(
                                                        paymentData.total_tagihan ||
                                                            subtotal,
                                                    )}
                                                </strong>
                                            </>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </>
                ) : null
            }
        </main>
        <script
            is:inline
            define:vars={{
                token: paymentData.snap_token,
                idPesanan: paymentData.id_pesanan,
            }}
        >
            // Menunggu DOM selesai dimuat
            document.addEventListener('DOMContentLoaded', () => {
                if (token && window.snap) {
                    window.snap.embed(token, {
                        embedId: 'snap-container',
                        onSuccess: function (result) {
                            window.location.href = `/billing/${idPesanan}`;
                        },
                    });
                }
            });
        </script>
    </body>
</html>
