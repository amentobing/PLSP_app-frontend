        <!-- Modal Checkout (Konfirmasi Data Pelanggan) -->
        <div
            class='modal fade'
            id='checkoutModal'
            tabindex='-1'
            aria-labelledby='checkoutModalLabel'
            aria-hidden='true'
        >
            <div class='modal-dialog modal-dialog-centered'>
                <div class='modal-content border-0 shadow'>
