// @ts-nocheck
import Navbar from '../components/Navbar.astro';
const BACKEND_URL = import.meta.env.BACKEND_URL || 'http://localhost:3000';
const productImages = [
    'https://images.unsplash.com/photo-1604908176997-125f25cc6f3d?auto=format&fit=crop&w=400&q=80',
    'https://images.unsplash.com/photo-1604503468506-a8da13d82791?auto=format&fit=crop&w=400&q=80',
    'https://images.unsplash.com/photo-1626844131082-256783844137?auto=format&fit=crop&w=400&q=80',
    'https://images.unsplash.com/photo-1603569283847-aa295f0d016a?auto=format&fit=crop&w=400&q=80',
    'https://images.unsplash.com/photo-1556679343-c7306c1976bc?auto=format&fit=crop&w=400&q=80',
    'https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?auto=format&fit=crop&w=400&q=80',
];

// fungsi untuk mendata untuk variable data-category agar bisa menjalankan fungsi filter kategori produk
/** @param {string} category */
const categorySlug = (category) => category.toLowerCase().replaceAll(' ', '-');

// Pengambilan data dari backend (database)
/** @param {string} path */
const fetchData = async (path) => {
    const response = await fetch(`${BACKEND_URL}${path}`);
    if (!response.ok) {
        throw new Error(`Backend mengembalikan status ${response.status}`);
    }

    const result = await response.json();
    return result.status === 'success' ? result.data : [];
};

// fungsi @type ini adalah untuk menghilangkan tampilan error pada typescript
/** @type {Array<{id: number, nama_kategori: string}>} */
let categories = [];
/** @type {Array<{id: number, id_kategori: number, nama_produk: string, harga: number, stok: number, nama_kategori: string}>} */
let products = [];
let apiError = '';
let initialCart = [];

if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const cartData = formData.get('cart_data');

    if (typeof cartData === 'string') {
        try {
            const parsedCart = JSON.parse(cartData);
            if (Array.isArray(parsedCart)) {
                initialCart = parsedCart;
            }
        } catch (error) {
            console.error('Cart dari checkout tidak valid:', error);
        }
    }
}

try {
    [categories, products] = await Promise.all([
        fetchData('/api/kategori'), // data categories
        fetchData('/api/produk'), // data products
    ]);
} catch (error) {
    apiError =
        'Menu belum dapat dimuat. Pastikan backend berjalan di port 3000.';
    console.error(error);
}
