                                            {product.stok > 0
                                                ? 'Tambah'
                                                : 'Habis'}
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- Grid menu lama disembunyikan agar tidak menduplikasi data backend. -->
            <div class='row g-3 g-md-4 d-none'>
                <!-- Makanan 1 -->
                <div
                    class='col-6 col-md-4 col-lg-3 product-item'
                    data-category='makanan'
                >
                    <div class='card h-100 shadow-sm border-0 product-card'>
                        <img
