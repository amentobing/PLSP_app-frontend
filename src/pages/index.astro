                        </div>
                    </div>
                    <div class='modal-footer border-top-0'>
                        <button
                            type='button'
                            class='btn btn-light'
                            data-bs-toggle='offcanvas'
                            data-bs-target='#cartOffcanvas'
                            data-bs-dismiss='modal'
                            >Kembali ke Pesanan</button
                        >
                        <!-- Ini akan memproses API/Backend nantinya -->
                        <button
                            type='button'
                            class='btn btn-danger px-4 fw-bold'
                            onclick='showSuccessMessage()'
                            >Proses Pesanan</button
                        >
                    </div>
                </div>
            </div>
        </div>

        <!-- Bootstrap JS dan Script Logic -->
        <script
            src='/js/bootstrap.bundle.min.js'
            is:inline
        ></script>
        <div
            id='initialCart'
            data-cart={JSON.stringify(initialCart)}
            hidden
        >
        </div>
        <script is:inline>
            // Array untuk menyimpan data pesanan (state)
            let cart = JSON.parse(
                document.getElementById('initialCart').dataset.cart || '[]',
            );

            // Inisialisasi Offcanvas Bootstrap agar bisa dipanggil via JS
            const cartOffcanvasEl = document.getElementById('cartOffcanvas');
            const bsOffcanvas = new bootstrap.Offcanvas(cartOffcanvasEl);

            // Fungsi Format Rupiah
            const formatRupiah = (number) => {
                return new Intl.NumberFormat('id-ID', {
                    style: 'currency',
                    currency: 'IDR',
                    minimumFractionDigits: 0,
                }).format(number);
            };

            // Fungsi Tambah ke Keranjang
            function addToCart(id, name, price) {
                // Cek apakah item sudah ada di keranjang
                const existingItemIndex = cart.findIndex(
                    (item) => item.id === id,
                );

                if (existingItemIndex > -1) {
                    // Jika ada, tambah quantity
                    cart[existingItemIndex].qty += 1;
                } else {
                    // Jika baru, push ke array
                    cart.push({ id, name, price, qty: 1 });
                }

                // Animasi Badge
                animateBadge();

                // Render ulang tampilan keranjang
                renderCartUI();

                // Otomatis buka popup (offcanvas) jika ini item pertama yang ditambahkan
                if (cart.length === 1 && cart[0].qty === 1) {
                    bsOffcanvas.show();
                }
            }

            // Fungsi Ubah Quantity (Plus / Minus)
            function updateQty(id, delta) {
                const itemIndex = cart.findIndex((item) => item.id === id);
                if (itemIndex > -1) {
                    cart[itemIndex].qty += delta;

                    // Hapus jika qty 0 atau kurang
                    if (cart[itemIndex].qty <= 0) {
                        cart.splice(itemIndex, 1);
                    }

                    renderCartUI();
                }
            }

            // Render UI Keranjang
            function renderCartUI() {
                const cartList = document.getElementById('cartList');
                const emptyState = document.getElementById('emptyCartState');
                const itemsContainer =
                    document.getElementById('cartItemsContainer');
                const footer = document.getElementById('cartFooter');
                const badge = document.getElementById('cartBadge');

                // Reset List HTML
                cartList.innerHTML = '';

                let totalQty = 0;
                let subtotal = 0;

                if (cart.length === 0) {
                    // Tampilkan Empty State
                    emptyState.classList.remove('d-none');
                    itemsContainer.classList.add('d-none');
                    footer.classList.add('d-none');
                    badge.textContent = '0';
                } else {
                    // Sembunyikan Empty State
                    emptyState.classList.add('d-none');
                    itemsContainer.classList.remove('d-none');
                    footer.classList.remove('d-none');

                    // Generate HTML List Item
                    cart.forEach((item) => {
                        totalQty += item.qty;
                        const itemTotal = item.price * item.qty;
                        subtotal += itemTotal;

                        cartList.innerHTML += `
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-0 border-bottom">
                            <div class="me-auto pe-2">
                                <h6 class="mb-1 fw-bold fs-6">${item.name}</h6>
                                <small class="text-danger fw-bold">${formatRupiah(item.price)}</small>
                            </div>
                            <div class="d-flex align-items-center bg-light rounded-pill p-1 border">
                                <button onclick="updateQty(${item.id}, -1)" class="btn qty-btn"><i class="bi bi-dash"></i></button>
                                <span class="fw-bold text-center" style="min-width: 30px;">${item.qty}</span>
                                <button onclick="updateQty(${item.id}, 1)" class="btn qty-btn"><i class="bi bi-plus"></i></button>
                            </div>
                        </li>
                    `;
                    });

                    badge.textContent = totalQty;

                    // Hitung Pajak dan Total
                    const grandTotal = subtotal;

                    // Update Label Harga
                    document.getElementById('subtotalLabel').textContent =
                        formatRupiah(subtotal);
                    document.getElementById('totalLabel').textContent =
                        formatRupiah(grandTotal);
                    document.getElementById('cartDataInput').value =
                        JSON.stringify(cart);
                }
            }

            // Animasi kecil saat tambah barang
            function animateBadge() {
                const badge = document.getElementById('cartBadge');
                badge.classList.add('cart-bump');
                setTimeout(() => {
                    badge.classList.remove('cart-bump');
                }, 200);
            }

            // Logic Filter Kategori
            const filterBtns = document.querySelectorAll('.filter-btn');
            const productItems = document.querySelectorAll(
                '#productGrid .product-item',
            );

            filterBtns.forEach((btn) => {
                btn.addEventListener('click', function () {
                    // Hapus state aktif dari semua tombol filter
                    filterBtns.forEach((b) => {
                        b.classList.remove('active');
                        b.classList.add('bg-white', 'border');
                    });

                    // Tambahkan state aktif ke tombol yang diklik
                    this.classList.add('active');
                    this.classList.remove('bg-white', 'border');

                    // Dapatkan nilai kategori dari tombol
                    const selectedCategory = this.getAttribute('data-category');

                    // Tampilkan atau sembunyikan produk sesuai kategori
                    productItems.forEach((item) => {
                        if (
                            selectedCategory === 'semua' ||
                            item.getAttribute('data-category') ===
                                selectedCategory
                        ) {
                            item.classList.remove('d-none'); // Tampilkan produk menggunakan utilitas bawaan bootstrap (display block)
                        } else {
                            item.classList.add('d-none'); // Sembunyikan produk menggunakan utilitas display:none bootstrap
                        }
                    });
                });
            });

            // Render kembali cart yang dikirim dari halaman checkout.
            renderCartUI();

            // Dummy fungsi sukses (Mengganti alert)
            function showSuccessMessage() {
                const modalBody = document.querySelector(
                    '#checkoutModal .modal-body',
                );
                const modalFooter = document.querySelector(
                    '#checkoutModal .modal-footer',
                );

                modalBody.innerHTML = `
                <div class="text-center py-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    <h4 class="fw-bold mt-3">Pesanan Berhasil Dibuat!</h4>
                    <p class="text-muted">Tagihan Anda sedang dicetak. Silakan menuju kasir jika memilih pembayaran Tunai.</p>
                </div>
            `;
                modalFooter.innerHTML = `
                <button type="button" class="btn btn-danger w-100 fw-bold" data-bs-dismiss="modal" onclick="location.reload()">Selesai</button>
            `;
            }
        </script>
    </body>
</html>
